# Copy to repository-root .env; backend loads this file explicitly.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8
# mock reads the labelled fixture; live requests Open-Meteo with fixture fallback.
WEATHER_MODE=mock
CORS_ORIGINS=http://localhost:5173
# frontend uses Vite proxy /api -> http://127.0.0.1:8000
